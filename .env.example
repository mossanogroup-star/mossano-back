# Copy to .env and fill in. .env is gitignored and must stay that way —
# it carries the database password and the Cloudinary secret.

NODE_ENV=development
PORT=5000

# --- Database ---
# Atlas connection string. Include the database name in the path, otherwise
# Mongoose silently uses "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/mossano

# --- Auth ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=12h

# The first admin, created by `npm run seed:admin`.
SEED_ADMIN_EMAIL=mossanogroup@gmail.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=MOSSANO Admin

# --- Frontend ---
# Where the Vite project lives, relative to this folder. The server renders the
# storefront from its build output and serves its client assets.
# Where mossano-front lives. Locally it is the sibling folder; on Render the
# build clones it here instead, because the two are separate repos and this
# service renders the storefront from its build output. See render.yaml.
FRONTEND_DIR=../mossano-front
# Absolute public origin, used for canonical URLs, og:url and private links.
PUBLIC_BASE_URL=http://localhost:5000
# Extra origins allowed to call the API (comma-separated). The SSR storefront is
# same-origin and needs no entry; add the Vite dev server if you run it standalone.
CORS_ORIGIN=http://localhost:5173

# --- Media (Cloudinary) ---
# Leave STORAGE_PROVIDER empty to auto-select: Cloudinary when all three
# credentials below are present, local disk otherwise.
STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mossano
MAX_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100

# --- WhatsApp ---
# The number every wa.me deep link points at. Digits only, with country code.
WHATSAPP_NUMBER=919619176132

# --- Private selection links ---
SELECTION_LINK_TTL_DAYS=90

# --- SSR cache ---
# Seconds a rendered page is served before it is refreshed in the background.
# Admin writes invalidate affected pages immediately regardless of this.
SSR_CACHE_TTL_SECONDS=300

# --- Alerting the team when an enquiry arrives ---
# "Backend automatically → Executive ko WhatsApp" (Website Notes).
# Leave NOTIFY_PROVIDER empty to auto-select: whatsapp if its credentials are
# present, else email if SMTP is, else "log" (writes the alert to the server log
# so the path still works, but nobody is actually notified).
NOTIFY_PROVIDER=
EXECUTIVE_WHATSAPP=
EXECUTIVE_EMAIL=

# WhatsApp Business Cloud API — needed only for automatic OUTBOUND messages.
# The wa.me links elsewhere on the site need none of this.
# A template must be approved by Meta to deliver outside a 24-hour window.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# SMTP — the cheaper alternative. See docs/CLIENT-QUESTIONS.md §12.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Home page hero ---
# The slab on the home page, by MOSSANO code. Pinned so it only ever changes
# when someone deliberately changes it. If the code does not resolve to a
# published stone, the server falls back to the best-ranked candidate.
# MOSSANO code of the hero slab. Blank falls back to the measured default.
# Run `npm run measure:hero` to rank every lot by type legibility.
HERO_STONE_CODE=MM-001MM-013
