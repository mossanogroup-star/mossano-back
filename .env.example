# Copy to .env and fill in. .env is gitignored and must stay that way —
# it carries the database password and the Cloudinary secret.

NODE_ENV=development
PORT=5000

# --- Database ---
# Atlas connection string. Include the database name in the path, otherwise
# Mongoose silently uses "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/mossano

# --- Auth ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=12h

# The first admin, created by `npm run seed:admin`.
SEED_ADMIN_EMAIL=mossanogroup@gmail.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=MOSSANO Admin

# --- Frontend ---
# Where the Vite project lives, relative to this folder. The server renders the
# storefront from its build output and serves its client assets.
FRONTEND_DIR=../mossano-front
# Absolute public origin, used for canonical URLs, og:url and private links.
PUBLIC_BASE_URL=http://localhost:5000
# Extra origins allowed to call the API (comma-separated). The SSR storefront is
# same-origin and needs no entry; add the Vite dev server if you run it standalone.
CORS_ORIGIN=http://localhost:5173

# --- Media (Cloudinary) ---
# Leave STORAGE_PROVIDER empty to auto-select: Cloudinary when all three
# credentials below are present, local disk otherwise.
STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mossano
MAX_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100

# --- WhatsApp ---
# The number every wa.me deep link points at. Digits only, with country code.
WHATSAPP_NUMBER=919619176132

# --- Private selection links ---
SELECTION_LINK_TTL_DAYS=90

# --- SSR cache ---
# Seconds a rendered page is served before it is refreshed in the background.
# Admin writes invalidate affected pages immediately regardless of this.
SSR_CACHE_TTL_SECONDS=300
