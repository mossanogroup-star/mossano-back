{
  "name": "mossano-back",
  "version": "1.0.0",
  "description": "MOSSANO MARMO — API, admin backend and server-rendered storefront",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:stones": "node scripts/seedStones.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run format:check",
    "prune:media": "node scripts/pruneOrphanMedia.js",
    "format:check": "prettier --check .",
    "measure:hero": "node scripts/measureHeroLegibility.js",
    "seed:phase2": "node scripts/seedPhase2.js",
    "migrate:exotic": "node scripts/migrateExoticColour.js",
    "gen:countries": "node scripts/generateCountries.js",
    "migrate:origin": "node scripts/migrateOriginCountry.js",
    "import:process": "node scripts/importProcessImages.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.33.5",
    "sirv": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.3",
    "vite": "^5.4.11"
  }
}
